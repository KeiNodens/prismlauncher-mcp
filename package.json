{
  "name": "@keinodens/prism-mcp",
  "version": "0.4.2",
  "description": "MCP server for Prism Launcher: file-level instance/mod/world management (Layer 1 of the prism project)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "prism-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
