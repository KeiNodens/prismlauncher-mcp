    "test": "npm run build && node --test tests/unit.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0",
    "prismarine-nbt": "^2.7.0",
