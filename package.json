  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "@types/adm-zip": "^0.5.7"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeiNodens/prism-mcp.git"
  },
  "homepage": "https://github.com/KeiNodens/prism-mcp#readme",
  "bugs": {
    "url": "https://github.com/KeiNodens/prism-mcp/issues"
  },
  "keywords": [
    "mcp",
